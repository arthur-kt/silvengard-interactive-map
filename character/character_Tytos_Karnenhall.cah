t\":{\"descriptionModels\":[{\"description\":\"Thanks to your noble birth, people are inclined to think the best of you. You are welcome in high society, and people assume you have the right to be wherever you are. The common folk and merchants make every effort to accommodate you and avoid your displeasure, and other people of high birth treat you as a member of the same social sphere. You can secure an audience with a local noble if you need to.\",\"level\":1}],\"id\":\"Custombdb00d92-6e3d-4184-bbf4-d8cba2524232\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Position Of Privilege\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1}],\"goldPieces\":25,\"id\":\"noble\",\"jsonType\":\"background\",\"languages\":[{\"description\":\"Choose 1\",\"shouldSelect\":true}],\"name\":\"Noble\",\"skills\":[{\"amountOfChoice\":1,\"id\":\"990a16b0-219a-4865-8746-469b32be6609\",\"skills\":[{}],\"skillsModels\":[{\"name\":\"History\",\"typeName\":\"SKILL\"}]},{\"amountOfChoice\":1,\"id\":\"2a36275b-dfa7-4bc3-b7b3-904184a78e00\",\"skills\":[{}],\"skillsModels\":[{\"name\":\"Persuasion\",\"typeName\":\"SKILL\"}]}],\"tools\":[{\"description\":\"1 type of Gaming Set\",\"shouldSelect\":true}],\"weapons\":[]}","requiredRace":"{\"abilityScores\":{\"cha\":1,\"con\":1,\"dex\":1,\"intelligence\":1,\"str\":1,\"wis\":1},\"ac\":10,\"armorProficiencies\":[],\"id\":\"human\",\"jsonType\":\"race\",\"languages\":[{\"hint\":\"\",\"level\":1,\"proficiency\":\"Common\"},{\"hint\":\"\",\"level\":1,\"proficiency\":\"Choose 1\"}],\"name\":\"Human\",\"racialWeapon\":{\"abilityName\":\"Strength\",\"damageType\":\"Bludgeoning\",\"diceAmount\":0,\"diceTypeName\":\"d4\",\"name\":\"Unarmed Strike\"},\"skillProficiencies\":[],\"speed\":{\"burrow\":0,\"climb\":0,\"fly\":0,\"normal\":30,\"swim\":0},\"spellcastingAbility\":\"Intelligence\",\"spells\":[],\"subraces\":[],\"toolProficiencies\":[],\"traits\":[],\"weaponProficiencies\":[]}","selectableFeatures":[{"amountsPerLevel":[{"amount":1,"level":4}],"availableFeatures":[{"feat":{"descriptionModels":[{"description":"Whenever you reach a level in this class that grants the Ability Score Improvement feature, you can replace a fighting style you know with another fighting style available to paladins. This replacement represents a shift of focus in your martial practice","level":4}],"id":"Custom212c5b84-20ac-4ee5-85cc-8c25780359d9","isFeature":true,"jsonType":"feat","level":1,"name":"Martial Versatility","notes":"","type":"Feat"},"level":4}],"canReselect":false,"id":"2ff48ca2-771f-4e35-adad-c3191c3d562b","name":"Paladin Optional Features","selectedFeatures":[{"descriptions":[{"description":"Whenever you reach a level in this class that grants the Ability Score Improvement feature, you can replace a fighting style you know with another fighting style available to paladins. This replacement represents a shift of focus in your martial practice","level":4}],"id":"Custom212c5b84-20ac-4ee5-85cc-8c25780359d9","isFeature":false,"jsonType":"feat","name":"Martial Versatility","notes":"","type":"Feat"}]}],"silver":0,"skills":[{"proficiencyName":"NONE","typeName":"ACROBATICS"},{"proficiencyName":"NONE","typeName":"ANIMAL_HANDLING"},{"proficiencyName":"NONE","typeName":"ARCANA"},{"proficiencyName":"FULL","typeName":"ATHLETICS"},{"proficiencyName":"NONE","typeName":"DECEPTION"},{"proficiencyName":"FULL","typeName":"HISTORY"},{"proficiencyName":"FULL","typeName":"INSIGHT"},{"proficiencyName":"NONE","typeName":"INTIMIDATION"},{"proficiencyName":"NONE","typeName":"INVESTIGATION"},{"proficiencyName":"NONE","typeName":"MEDICINE"},{"proficiencyName":"NONE","typeName":"NATURE"},{"proficiencyName":"NONE","typeName":"PERCEPTION"},{"proficiencyName":"NONE","typeName":"PERFORMANCE"},{"proficiencyName":"FULL","typeName":"PERSUASION"},{"proficiencyName":"NONE","typeName":"RELIGION"},{"proficiencyName":"NONE","typeName":"SLEIGHT_OF_HAND"},{"proficiencyName":"NONE","typeName":"STEALTH"},{"proficiencyName":"NONE","typeName":"SURVIVAL"}],"specialAbilities":[{"abilityCalculators":[],"amountsPerLevel":[{"amount":5,"level":1},{"amount":10,"level":2},{"amount":15,"level":3},{"amount":20,"level":4},{"amount":25,"level":5},{"amount":30,"level":6},{"amount":35,"level":7},{"amount":40,"level":8},{"amount":45,"level":9},{"amount":50,"level":10},{"amount":55,"level":11},{"amount":60,"level":12},{"amount":65,"level":13},{"amount":70,"level":14},{"amount":75,"level":15},{"amount":80,"level":16},{"amount":85,"level":17},{"amount":90,"level":18},{"amount":95,"level":19},{"amount":100,"level":20}],"associatedValueName":"","id":"bbf62918-ebb4-43d7-ae9e-61b93105748d","name":"Lay On Hands Points","type":"BASIC","usesLeft":35},{"abilityCalculators":[{"calculators":[{"operands":[{"multiplierConstant":1,"operator":"PLUS","stat":"CHA"},{"multiplierConstant":1,"operator":"PLUS"}]}],"level":1,"topLevelConnector":"MAX"}],"amountsPerLevel":[],"associatedValueName":"","id":"0756b420-aa9c-463d-b85f-744c9dfa1b73","name":"Divine Sense Uses","type":"ADVANCED","usesLeft":4},{"abilityCalculators":[{"calculators":[{"operands":[{"multiplierConstant":1,"operator":"PLUS","stat":"CHA"}]},{"operands":[{"multiplierConstant":1,"operator":"PLUS"}]}],"level":14,"topLevelConnector":"MAX"}],"amountsPerLevel":[],"associatedValueName":"","id":"c301dd7d-bc96-4952-851f-015cbd5efb87","name":"Cleansing Touch Uses","type":"ADVANCED","usesLeft":0}],"speedModifier":0,"spellAttackExtraBonus":0,"spellDCExtraBonus":0,"spellSlots":{"eighth":0,"fifth":0,"first":4,"fourth":0,"ninth":0,"second":3,"seventh":0,"sixth":0,"third":0},"spells":[{"castingTime":"1 action","classes":"cleric, paladin, warlock, blood_hunter, fighter, rogue, wizard","components":"V, S, M (holy water or powdered silver and iron, which the spell consumes)","description":"Until the spell ends, one willing creature you touch is protected against certain types of creatures: aberrations, celestials, elementals, fey, fiends, and undead.\nThe protection grants several benefits. Creatures of those types have disadvantage on attack rolls against the target. The target also can\u0027t be charmed, frightened, or possessed by them. If the target is already charmed, frightened, or possessed by such a creature, the target has advantage on any new saving throw against the relevant effect.","duration":"Concentration, up to 10 minutes","higherLevels":"","isCustom":false,"isRitual":false,"jsonType":"spell","level":1,"name":"Protection from Evil and Good","notes":"","pinned":false,"prepared":false,"range":"Touch","school":"abjuration","type":"1st-level abjuration"},{"castingTime":"1 bonus action","classes":"artificer, artificer__eb_, artificer__revised_, cleric","components":"V, S, M (a small silver mirror)","description":"You ward a creature within range against attack. Until the spell ends, any creature who targets the warded creature with an attack or a harmful spell must first make a Wisdom saving throw. On a failed save, the creature must choose a new target or lose the attack or spell. This spell doesn’t protect the warded creature from area effects, such as the explosion of a fireball.\n\nIf the warded creature makes an attack or casts a spell that affects an enemy creature, this spell ends.","duration":"1 minute","higherLevels":"","isCustom":false,"isRitual":false,"jsonType":"spell","level":1,"name":"Sanctuary","notes":"","pinned":false,"prepared":false,"range":"30 feet","school":"abjuration","type":"1st-level abjuration"},{"castingTime":"1 action","classes":"artificer, artificer__eb_, artificer__revised_, bard, cleric, druid, paladin, ranger__revised__, revised_ranger, ranger","components":"V, S","description":"You touch a creature and can end either one disease or one condition afflicting it. The condition can be blinded, deafened, paralyzed, or poisoned.","duration":"Instantaneous","higherLevels":"","isCustom":false,"isRitual":false,"jsonType":"spell","level":2,"name":"Lesser Restoration","notes":"","pinned":false,"prepared":false,"range":"Touch","school":"abjuration","type":"2nd-level abjuration"},{"castingTime":"1 action","classes":"bard, cleric, paladin","components":"V, S","description":"You create a magical zone that guards against deception in a 15-foot-radius sphere centered on a point of your choice within range. Until the spell ends, a creature that enters the spell\u0027s area for the first time on turn or starts its turn there must make a Charisma saving throw. On a failed save, a creature can\u0027t speak a deliberate lie while in the radius. you know whether each creature succeeds or fails on its saving throw.\n\nAn affected creature is aware of the spell and can thus avoid answering questions to which it would normally respond with a lie. Such a creature can be evasive in its answers as long as it remains within the boundaries of the truth.","duration":"10 minutes","higherLevels":"","isCustom":false,"isRitual":false,"jsonType":"spell","level":2,"name":"Zone of Truth","notes":"","pinned":false,"prepared":false,"range":"60 feet","school":"enchantment","type":"2nd-level enchantment"},{"castingTime":"1 bonus action","classes":"paladin","components":"V","description":"You attempt to compel a creature into a duel. One creature that you can see within range must make a Wisdom saving throw. On a failed save, the creature is drawn to you, compelled by your divine demand. For the duration, it has disadvantage on attack rolls against creatures other than you, and must make a Wisdom saving throw each time it attempts to move into a space that is more than 30 feet away from you; if it succeeds on this saving throw, the spell doesn\u0027t restrict the target\u0027s movement for that turn.\n\nThe spell ends if you attack any other creature, if you cast a spell that targets a hostile creature other than the target, if a creature friendly to you damages the target or casts a harmful spell on it, or if you end your turn more than 30 feet away from the target.","duration":"Concentration, up to 1 minute","higherLevels":"","isCustom":false,"isRitual":false,"jsonType":"spell","level":1,"name":"Compelled Duel","notes":"","pinned":false,"prepared":false,"range":"30 feet","school":"enchantment","type":"1st-level enchantment"},{"castingTime":"1 action","classes":"artificer, artificer__eb_, artificer__revised_, bard, cleric, druid, paladin, ranger__revised__, revised_ranger, ranger","components":"V, S","description":"A creature you touch regains a number of hit points equal to 1d8 + your spellcasting ability modifier. This spell has no effect on undead or constructs.","duration":"Instantaneous","higherLevels":"When you cast this spell using a spell slot of 2nd level or higher, the healing increases by 1d8 for each slot level above 1st.","isCustom":false,"isRitual":false,"jsonType":"spell","level":1,"name":"Cure Wounds","notes":"","pinned":false,"prepared":false,"range":"Touch","school":"evocation","type":"1st-level evocation"},{"castingTime":"1 action","classes":"cleric, paladin","components":"V","description":"You speak a one-word command to a creature you can see within range. The target must succeed on a Wisdom saving throw or follow the command on its next turn. The spell has no effect if the target is Undead, if it doesn\u0027t understand your language, or if your command is directly harmful to it.\n\nSome typical commands and their Effects follow. You might issue a command other than one described here. If you do so, the GM determines how the target behaves. If the target can\u0027t follow your command, the spell ends.\n\n- Approach: The target moves toward you by the shortest and most direct route, ending its turn if it moves within 5 feet of you.\n\n- Drop: The target drops whatever it is holding and then ends its turn.\n\n- Flee: The target spends its turn moving away from you by the fastest available means.\n\n- Grovel: The target falls prone and then ends its turn.\n\n- Halt: The target doesn\u0027t move and takes no Actions. A flying creature stays aloft, provided that it is able to do so. If it must move to stay aloft, it flies the minimum distance needed to remain in the air.","duration":"1 round","higherLevels":"When you cast this spell using a spell slot of 2nd level or higher, you can affect one additional creature for each slot level above 1st. The creatures must be within 30 feet of each other when you target them.","isCustom":false,"isRitual":false,"jsonType":"spell","level":1,"name":"Command","notes":"","pinned":false,"prepared":false,"range":"60 feet","school":"enchantment","type":"1st-level enchantment"},{"castingTime":"1 bonus action","classes":"artificer, artificer__revised_, cleric, paladin","components":"V, S, M (a small parchment with a bit of holy text written on it)","description":"A shimmering field appears and surrounds a creature of your choice within range, granting it a +2 bonus to AC for the duration.","duration":"Concentration, up to 10 minutes","higherLevels":"","isCustom":false,"isRitual":false,"jsonType":"spell","level":1,"name":"Shield of Faith","notes":"","pinned":false,"prepared":false,"range":"60 feet","school":"abjuration","type":"1st-level abjuration"},{"castingTime":"1 action","classes":"paladin","components":"V","description":"The next time you hit a creature with a weapon attack before this spell ends, the weapon gleams with astral radiance as you strike. The attack deals an extra 2d6 radiant damage to the target, which becomes visible if it’s invisible, and the target sheds dim light in a 5-foot radius and can’t become invisible until the spell ends.","duration":"Concentration, up to 1 minute","higherLevels":"When you cast this spell using a spell slot of 3rd level or higher, the extra damage increases by 1d6 for each slot level above 2nd.","isCustom":false,"isRitual":false,"jsonType":"spell","level":2,"name":"Branding Smite","notes":"","pinned":false,"prepared":false,"range":"self","school":"evocation","type":"2nd-Level evocation"},{"castingTime":"1 action","classes":"artificer, artificer__eb_, artificer__revised_, cleric, paladin","components":"V, S, M (a tiny strip of white cloth)","description":"Your spell bolsters your allies with toughness and resolve. Choose up to three creatures within range. Each target’s hit point maximum and current hit points increase by 5 for the duration.","duration":"8 hours","higherLevels":"When you cast this spell using a spell slot of 3rd level or higher, a target’s hit points increase by an additional 5 for each slot level above 2nd.","isCustom":false,"isRitual":false,"jsonType":"spell","level":2,"name":"Aid","notes":"","pinned":false,"prepared":false,"range":"30 feet","school":"abjuration","type":"2nd-level abjuration"}],"strength":{"save":false,"saveModifier":0,"score":18,"scoreModifier":0},"successes":0,"swimSpeedModifier":0,"tempHp":0,"updated":"2026-05-02T06:23:25Z","weapons":[{"ammunitionType":"","attackAbilityName":"Strength","bonus":0,"damageDiceAmount":1,"damageDiceName":"d8","damageTypeName":"Slashing","description":"","extraAttackBonus":1,"extraDamageBonus":1,"extraDamageDice":[],"hasReach":false,"id":"1d2cf87e-bf8d-4ba5-973c-04edf8141c5f","index":0,"isAttuned":false,"isCustom":true,"isFinesse":false,"isHeavy":false,"isImprovised":false,"isLight":false,"isLoading":false,"isRanged":false,"isSilver":false,"isSimple":false,"isSpecial":false,"isThrown":false,"isVersatile":true,"jsonType":"weapon","name":"Longsword","pinned":false,"proficient":true,"properties":"Versatile (1d10)","rarity":"Common","requiresAttunement":false,"twoHanded":false,"type":"Longsword","versatileDamageDiceAmount":1,"versatileDamageDie":"D10"}],"wisdom":{"save":true,"saveModifier":0,"score":10,"scoreModifier":0}}