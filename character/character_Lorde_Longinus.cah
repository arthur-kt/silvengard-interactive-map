ame\":\"Knight\",\"skills\":[{\"amountOfChoice\":1,\"id\":\"990a16b0-219a-4865-8746-469b32be6609\",\"skills\":[{}],\"skillsModels\":[{\"name\":\"History\",\"typeName\":\"SKILL\"}]},{\"amountOfChoice\":1,\"id\":\"2a36275b-dfa7-4bc3-b7b3-904184a78e00\",\"skills\":[{}],\"skillsModels\":[{\"name\":\"Persuasion\",\"typeName\":\"SKILL\"}]}],\"tools\":[{\"description\":\"1 type of Gaming Set\",\"shouldSelect\":true}],\"weapons\":[]}","requiredMonster":"{\"ac\":14,\"actions\":[{\"description\":\"+8 to hit, reach 5 ft., one target. Hit: 15 (2d8 + 4) bludgeoning damage.\",\"id\":4252,\"isLegendary\":false,\"isReaction\":false,\"monsterId\":1300,\"name\":\"Hooves\",\"type\":\"MELEE\"}],\"alignment\":\"Unaligned\",\"burrowSpeed\":0,\"cha\":7,\"climbSpeed\":0,\"con\":14,\"cr\":\"1\",\"dex\":14,\"flySpeed\":0,\"hp\":{\"constant\":5,\"diceAmount\":5,\"diceType\":\"D10\"},\"id\":1300,\"int\":2,\"isLocked\":false,\"jsonType\":\"monster\",\"name\":\"Zariel\",\"photo\":\"file:/storage/emulated/0/Android/data/com.blastervla.ddencountergenerator/files/Documents/e1946d00-0bed-48d8-825c-72ff8e0fda5b\",\"size\":\"Large\",\"specialTraits\":[{\"description\":\"If the horse moves at least 20 ft. Straight toward a creature and then hits it with a hooves attack on the same turn, that target must succeed on a DC 14 Strength saving throw or be knocked prone. If the target is prone, the horse can make another attack with its hooves against it as a bonus action.\",\"id\":2622,\"monsterId\":1300,\"name\":\"Trampling charge\"}],\"speed\":80,\"str\":20,\"swimSpeed\":0,\"tag\":\"\",\"type\":\"Beast\",\"wis\":12,\"xp\":100}","requiredRace":"{\"abilityScores\":{\"cha\":0,\"con\":0,\"dex\":0,\"intelligence\":0,\"str\":0,\"wis\":0},\"ac\":10,\"armorProficiencies\":[],\"id\":\"variant_human\",\"jsonType\":\"race\",\"languages\":[{\"hint\":\"\",\"level\":1,\"proficiency\":\"Common\"},{\"hint\":\"\",\"level\":1,\"proficiency\":\"Choose 1\"}],\"name\":\"Variant Human\",\"racialWeapon\":{\"abilityName\":\"Stren