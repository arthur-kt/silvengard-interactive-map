\"feat\",\"level\":1,\"name\":\"Fighting Style: Dueling\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1}],\"hpModifier\":\"Constitution\",\"id\":\"fighter_dueling\",\"jsonType\":\"class\",\"languages\":[],\"modelType\":\"Subtype\",\"multiclassArmor\":true,\"multiclassSkills\":true,\"multiclassTools\":true,\"multiclassWeapons\":true,\"name\":\"Dueling\",\"selectableFeatures\":[],\"shouldShowCompanion\":false,\"skillProficiencies\":[],\"specialAbilities\":[],\"spellSlots\":[],\"spellcastingAbility\":\"Intelligence\",\"spells\":[],\"subtypes\":[],\"toolProficiencies\":[],\"weaponProficiencies\":[]},{\"acModifier\":\"Dexterity\",\"armorProficiencies\":[],\"attacksByLevel\":[],\"baseAc\":10,\"classWeapon\":{\"abilityName\":\"Strength\",\"damageType\":\"Bludgeoning\",\"diceAmount\":1,\"diceTypeName\":\"D4\",\"name\":\"\"},\"effectiveCasterLevel\":\"PARENT\",\"features\":[{\"feat\":{\"descriptionModels\":[{\"description\":\"When you roll a 1 or 2 on a damage die for an attack you make with a melee weapon that you are wielding with two hands, you can reroll the die and must use the new roll, even if the new roll is a 1 or a 2. The weapon must have the two-handed or versatile property for you to gain this benefit\",\"level\":1}],\"id\":\"Custom2206d8fd-1a38-47be-8187-ca737ca1c77f\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Fighting Style: Great Weapon Fighting\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1}],\"hpModifier\":\"Constitution\",\"id\":\"fighter_great_weapon_fighting\",\"jsonType\":\"class\",\"languages\":[],\"modelType\":\"Subtype\",\"multiclassArmor\":true,\"multiclassSkills\":true,\"multiclassTools\":true,\"multiclassWeapons\":true,\"name\":\"Great Weapon Fighting\",\"selectableFeatures\":[],\"shouldShowCompanion\":false,\"skillProficiencies\":[],\"specialAbilities\":[],\"spellSlots\":[],\"spellcastingAbility\":\"Intelligence\",\"spells\":[],\"subtypes\":[],\"toolProficiencies\":[],\"weaponProficiencies\":[]},{\"acModifier\":\"Dexterity\",\"armorProficiencies\":[],\"attacksByLevel\":[],\"baseAc\":10,\"classWeapon\":{\"abilityName\":\"Strength\",\"damageType\":\"Bludgeoning\",\"diceAmount\":1,\"diceTypeName\":\"D4\",\"name\":\"\"},\"effectiveCasterLevel\":\"PARENT\",\"features\":[{\"feat\":{\"descriptionModels\":[{\"description\":\"When a creature you can see attacks a target other than you that is within 5 feet of you, you can use your reaction to impose disadvantage on the attack roll. You must be wielding a shield\",\"level\":1}],\"id\":\"Custom8be7c6b5-3944-42ed-9416-507ac07a40ae\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Fighting Style: Protection\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1}],\"hpModifier\":\"Constitution\",\"id\":\"fighter_protection\",\"jsonType\":\"class\",\"languages\":[],\"modelType\":\"Subtype\",\"multiclassArmor\":true,\"multiclassSkills\":true,\"multiclassTools\":true,\"multiclassWeapons\":true,\"name\":\"Protection\",\"selectableFeatures\":[],\"shouldShowCompanion\":false,\"skillProficiencies\":[],\"specialAbilities\":[],\"spellSlots\":[],\"spellcastingAbility\":\"Intelligence\",\"spells\":[],\"subtypes\":[],\"toolProficiencies\":[],\"weaponProficiencies\":[]},{\"acModifier\":\"Dexterity\",\"armorProficiencies\":[],\"attacksByLevel\":[],\"baseAc\":10,\"classWeapon\":{\"abilityName\":\"Strength\",\"damageType\":\"Bludgeoning\",\"diceAmount\":1,\"diceTypeName\":\"D4\",\"name\":\"\"},\"effectiveCasterLevel\":\"PARENT\",\"features\":[{\"feat\":{\"descriptionModels\":[{\"description\":\"When you engage in two-weapon fighting, you can add your ability modifier to the damage of the second attack\",\"level\":1}],\"id\":\"Custom65a097dc-c1c5-4058-b763-5a69b7fe2e4c\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Fighting Style: Two-Weapon Fighting\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1}],\"hpModifier\":\"Constitution\",\"id\":\"fighter_two-weapon_fighting\",\"jsonType\":\"class\",\"languages\":[],\"modelType\":\"Subtype\",\"multiclassArmor\":true,\"multiclassSkills\":true,\"multiclassTools\":true,\"multiclassWeapons\":true,\"name\":\"Two-Weapon Fighting\",\"selectableFeatures\":[],\"shouldShowCompanion\":false,\"skillProficiencies\":[],\"specialAbilities\":[],\"spellSlots\":[],\"spellcastingAbility\":\"Intelligence\",\"spells\":[],\"subtypes\":[],\"toolProficiencies\":[],\"weaponProficiencies\":[]},{\"acModifier\":\"Dexterity\",\"armorProficiencies\":[],\"attacksByLevel\":[],\"baseAc\":10,\"classWeapon\":{\"abilityName\":\"Strength\",\"damageType\":\"Bludgeoning\",\"diceAmount\":1,\"diceTypeName\":\"D4\",\"name\":\"\"},\"effectiveCasterLevel\":\"PARENT\",\"features\":[{\"feat\":{\"descriptionModels\":[{\"description\":\"As long as you are not wearing heavy armor or using a shield, you have a swimming speed and a climbing speed equal to your normal speed, and you gain a +1 bonus to AC\",\"level\":1}],\"id\":\"Customce4bdbe9-2357-4ae2-acdd-0a66f537e88f\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Fighting Style: Mariner\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1}],\"hpModifier\":\"Constitution\",\"id\":\"fighter_mariner\",\"jsonType\":\"class\",\"languages\":[],\"modelType\":\"Subtype\",\"multiclassArmor\":true,\"multiclassSkills\":true,\"multiclassTools\":true,\"multiclassWeapons\":true,\"name\":\"Mariner\",\"selectableFeatures\":[],\"shouldShowCompanion\":false,\"skillProficiencies\":[],\"specialAbilities\":[],\"spellSlots\":[],\"spellcastingAbility\":\"Intelligence\",\"spells\":[],\"subtypes\":[],\"toolProficiencies\":[],\"weaponProficiencies\":[]},{\"acModifier\":\"Dexterity\",\"armorProficiencies\":[],\"attacksByLevel\":[],\"baseAc\":10,\"classWeapon\":{\"abilityName\":\"Strength\",\"damageType\":\"Bludgeoning\",\"diceAmount\":1,\"diceTypeName\":\"D4\",\"name\":\"\"},\"effectiveCasterLevel\":\"PARENT\",\"features\":[{\"feat\":{\"descriptionModels\":[{\"description\":\"You are trained in making ranged attack at close quarters. When making a ranged attack while you are within 5 feet of a hostile creature, you do not have disadvantage on the attack roll. Your ranged attacks ignore half cover and three-quarters cover against targets within 30 feet of you. Finally, you have a +1 bonus to attack rolls on ranged attacks\",\"level\":1}],\"id\":\"Customba470d47-7cac-4e00-b2b3-78a31ce33470\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Fighting Style: Close Quarters Shooter\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1}],\"hpModifier\":\"Constitution\",\"id\":\"fighter_close_quarters_shooter\",\"jsonType\":\"class\",\"languages\":[],\"modelType\":\"Subtype\",\"multiclassArmor\":true,\"multiclassSkills\":true,\"multiclassTools\":true,\"multiclassWeapons\":true,\"name\":\"Close Quarters Shooter\",\"selectableFeatures\":[],\"shouldShowCompanion\":false,\"skillProficiencies\":[],\"specialAbilities\":[],\"spellSlots\":[],\"spellcastingAbility\":\"Intelligence\",\"spells\":[],\"subtypes\":[],\"toolProficiencies\":[],\"weaponProficiencies\":[]},{\"acModifier\":\"Dexterity\",\"armorProficiencies\":[],\"attacksByLevel\":[],\"baseAc\":10,\"classWeapon\":{\"abilityName\":\"Strength\",\"damageType\":\"Bludgeoning\",\"diceAmount\":1,\"diceTypeName\":\"D4\",\"name\":\"\"},\"effectiveCasterLevel\":\"PARENT\",\"features\":[{\"feat\":{\"descriptionModels\":[{\"description\":\"You excel at defending narrow passages, doorways, and other tight spaces. As a bonus action, you can enter a defensive stance that lasts until the start of your next turn. While in your defensive stance, you can make opportunity attacks without using your reaction, and you can use your reaction to make a melee attack against a creature that moves more than 5 feet while within your reach\",\"level\":1}],\"id\":\"Custom5045e1f7-070e-4346-82e7-55151ec798ba\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Fighting Style: Tunnel Fighter\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1}],\"hpModifier\":\"Constitution\",\"id\":\"fighter_tunnel_fighter\",\"jsonType\":\"class\",\"languages\":[],\"modelType\":\"Subtype\",\"multiclassArmor\":true,\"multiclassSkills\":true,\"multiclassTools\":true,\"multiclassWeapons\":true,\"name\":\"Tunnel Fighter\",\"selectableFeatures\":[],\"shouldShowCompanion\":false,\"skillProficiencies\":[],\"specialAbilities\":[],\"spellSlots\":[],\"spellcastingAbility\":\"Intelligence\",\"spells\":[],\"subtypes\":[],\"toolProficiencies\":[],\"weaponProficiencies\":[]},{\"acModifier\":\"Dexterity\",\"armorProficiencies\":[],\"attacksByLevel\":[],\"baseAc\":10,\"classWeapon\":{\"abilityName\":\"Strength\",\"damageType\":\"Bludgeoning\",\"diceAmount\":1,\"diceTypeName\":\"D4\",\"name\":\"\"},\"effectiveCasterLevel\":\"PARENT\",\"features\":[{\"feat\":{\"descriptionModels\":[{\"description\":\"You have blindsight with a range of 10 feet. Within that range, you can effectively see anything that isn\\u0027t behind total cover, even if you\\u0027re blinded or in darkness. Moreover, you can see an invisible creature within that range, unless the creature successfully hides from you\",\"level\":1}],\"id\":\"Custom2fdc627b-18a4-4a8b-a124-08aa9bc553da\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Fighting Style: Blind Fighting\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1}],\"hpModifier\":\"Constitution\",\"id\":\"fighter_blind_fighting_[tce]\",\"jsonType\":\"class\",\"languages\":[],\"modelType\":\"Subtype\",\"multiclassArmor\":true,\"multiclassSkills\":true,\"multiclassTools\":true,\"multiclassWeapons\":true,\"name\":\"Blind Fighting [TCE]\",\"selectableFeatures\":[],\"shouldShowCompanion\":false,\"skillProficiencies\":[],\"specialAbilities\":[],\"spellSlots\":[],\"spellcastingAbility\":\"Intelligence\",\"spells\":[],\"subtypes\":[],\"toolProficiencies\":[],\"weaponProficiencies\":[]},{\"acModifier\":\"Dexterity\",\"armorProficiencies\":[],\"attacksByLevel\":[],\"baseAc\":10,\"classWeapon\":{\"abilityName\":\"Strength\",\"damageType\":\"Bludgeoning\",\"diceAmount\":1,\"diceTypeName\":\"D4\",\"name\":\"\"},\"effectiveCasterLevel\":\"PARENT\",\"features\":[{\"feat\":{\"descriptionModels\":[{\"description\":\"When a creature you can see hits a target, other than you, within 5 feet of you with an attack, you can use your reaction to reduce the damage the target takes by 1d10 + your proficiency bonus (to a minimum of 0 damage). You must be wielding a shield or a simple or martial weapon to use this reaction\",\"level\":1}],\"id\":\"Custom32e062f7-c9b1-436c-b536-fd5c9a05b95a\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Fighting Style: Interception\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1}],\"hpModifier\":\"Constitution\",\"id\":\"fighter_interception_[tce]\",\"jsonType\":\"class\",\"languages\":[],\"modelType\":\"Subtype\",\"multiclassArmor\":true,\"multiclassSkills\":true,\"multiclassTools\":true,\"multiclassWeapons\":true,\"name\":\"Interception [TCE]\",\"selectableFeatures\":[],\"shouldShowCompanion\":false,\"skillProficiencies\":[],\"specialAbilities\":[],\"spellSlots\":[],\"spellcastingAbility\":\"Intelligence\",\"spells\":[],\"subtypes\":[],\"toolProficiencies\":[],\"weaponProficiencies\":[]},{\"acModifier\":\"Dexterity\",\"armorProficiencies\":[],\"attacksByLevel\":[],\"baseAc\":10,\"classWeapon\":{\"abilityName\":\"Strength\",\"damageType\":\"Bludgeoning\",\"diceAmount\":1,\"diceTypeName\":\"D4\",\"name\":\"\"},\"effectiveCasterLevel\":\"PARENT\",\"features\":[{\"feat\":{\"descriptionModels\":[{\"description\":\"You learn one maneuver of your choice from among those available to the Battle Master archetype. If a maneuver you use requires your target to make a saving throw to resist the maneuver\\u0027s effects, the saving throw DC equals 8 + your proficiency bonus + your Strength or Dexterity modifier (your choice).\\n\\nYou gain one superiority die, which is a d6 (this die is added to any superiority dice you have from another source). This die is used to fuel your maneuvers. A superiority die is expended when you use it. You regain your expended superiority dice when you finish a short or long rest\",\"level\":1}],\"id\":\"Custom84360095-82c5-4750-823f-a32e0b753fc8\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Fighting Style: Superior Technique\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1}],\"hpModifier\":\"Constitution\",\"id\":\"fighter_superior_technique_[tce]\",\"jsonType\":\"class\",\"languages\":[],\"modelType\":\"Subtype\",\"multiclassArmor\":true,\"multiclassSkills\":true,\"multiclassTools\":true,\"multiclassWeapons\":true,\"name\":\"Superior Technique [TCE]\",\"selectableFeatures\":[],\"shouldShowCompanion\":false,\"skillProficiencies\":[],\"specialAbilities\":[],\"spellSlots\":[],\"spellcastingAbility\":\"Intelligence\",\"spells\":[],\"subtypes\":[],\"toolProficiencies\":[],\"weaponProficiencies\":[]},{\"acModifier\":\"Dexterity\",\"armorProficiencies\":[],\"attacksByLevel\":[],\"baseAc\":10,\"classWeapon\":{\"abilityName\":\"Strength\",\"damageType\":\"Bludgeoning\",\"diceAmount\":1,\"diceTypeName\":\"D4\",\"name\":\"\"},\"effectiveCasterLevel\":\"PARENT\",\"features\":[{\"feat\":{\"descriptionModels\":[{\"description\":\"You can draw a weapon that has the thrown property as part of the attack you make with the weapon.\\n\\nIn addition, when you hit with a ranged attack using a thrown weapon, you gain a +2 bonus to the damage roll\",\"level\":1}],\"id\":\"Custom98593d6c-dc12-4e31-b6f3-700e255db424\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Fighting Style: Thrown Weapon Fighting\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1}],\"hpModifier\":\"Constitution\",\"id\":\"fighter_thrown_weapon_fighting_[tce]\",\"jsonType\":\"class\",\"languages\":[],\"modelType\":\"Subtype\",\"multiclassArmor\":true,\"multiclassSkills\":true,\"multiclassTools\":true,\"multiclassWeapons\":true,\"name\":\"Thrown Weapon Fighting [TCE]\",\"selectableFeatures\":[],\"shouldShowCompanion\":false,\"skillProficiencies\":[],\"specialAbilities\":[],\"spellSlots\":[],\"spellcastingAbility\":\"Intelligence\",\"spells\":[],\"subtypes\":[],\"toolProficiencies\":[],\"weaponProficiencies\":[]},{\"acModifier\":\"Dexterity\",\"armorProficiencies\":[],\"attacksByLevel\":[],\"baseAc\":10,\"classWeapon\":{\"abilityName\":\"Strength\",\"damageType\":\"Bludgeoning\",\"diceAmount\":1,\"diceTypeName\":\"D4\",\"name\":\"\"},\"effectiveCasterLevel\":\"PARENT\",\"features\":[{\"feat\":{\"descriptionModels\":[{\"description\":\"Your unarmed strikes can deal bludgeoning damage equal to 1d6 + your Strength modifier on a hit. If you aren\\u0027t wielding any weapons or a shield when you make the attack roll, the d6 becomes a d8.\\n\\nAt the start of each of your turns, you can deal 1d4 bludgeoning damage to one creature grappled by you\",\"level\":1}],\"id\":\"Custom313ffa2d-b5f1-4bee-845b-7ffc99efcc43\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Fighting Style: Unarmed Fighting\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1}],\"hpModifier\":\"Constitution\",\"id\":\"fighter_unarmed_fighting_[tce]\",\"jsonType\":\"class\",\"languages\":[],\"modelType\":\"Subtype\",\"multiclassArmor\":true,\"multiclassSkills\":true,\"multiclassTools\":true,\"multiclassWeapons\":true,\"name\":\"Unarmed Fighting [TCE]\",\"selectableFeatures\":[],\"shouldShowCompanion\":false,\"skillProficiencies\":[],\"specialAbilities\":[],\"spellSlots\":[],\"spellcastingAbility\":\"Intelligence\",\"spells\":[],\"subtypes\":[],\"toolProficiencies\":[],\"weaponProficiencies\":[]},{\"acModifier\":\"Dexterity\",\"armorProficiencies\":[],\"attacksByLevel\":[],\"baseAc\":10,\"classWeapon\":{\"abilityName\":\"Strength\",\"damageType\":\"Bludgeoning\",\"diceAmount\":1,\"diceTypeName\":\"D4\",\"name\":\"\"},\"effectiveCasterLevel\":\"PARENT\",\"features\":[{\"feat\":{\"descriptionModels\":[{\"description\":\"You learn one maneuver of your choice from among those available to the Battle Master archetype. If a maneuver you use requires your target to make a saving throw to resist the maneuver’s effects, the saving throw DC equals 8 + your proficiency bonus + your Strength or Dexterity modifier (your choice). You gain one superiority die, which is a d6 (this die is added to any superiority dice you have from another source). This die is used to fuel your maneuvers. A superiority die is expended when you use it. You regain your expended superiority dice when you finish a short or long rest.\",\"level\":1}],\"id\":\"Custom090758c5-1c1e-4501-9f83-f108205e4776\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Fighting Style: Superior Technique\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1}],\"hpModifier\":\"Constitution\",\"id\":\"Custom428dec66-9cce-4564-adda-f37059bfdac3\",\"jsonType\":\"class\",\"languages\":[],\"modelType\":\"Subtype\",\"multiclassArmor\":true,\"multiclassSkills\":true,\"multiclassTools\":true,\"multiclassWeapons\":true,\"name\":\"Superior Technique\",\"selectableFeatures\":[{\"amountsPerLevel\":[{\"amount\":1,\"level\":1}],\"availableFeatures\":[{\"feat\":{\"descriptionModels\":[{\"description\":\"When you take the Attack action on your turn, you can forgo one of your attacks and use a bonus action to direct one of your companions to strike. When you do so, choose a friendly creature who can see or hear you and expend one superiority die. That creature can immediately use its reaction to make one weapon attack, adding the superiority die to the attack\\u0027s damage roll\",\"level\":1}],\"id\":\"Custom8cba6852-cbaa-4283-92c0-09211dae7f80\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Commander\\u0027s Strike\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1},{\"feat\":{\"descriptionModels\":[{\"description\":\"When you hit a creature with a weapon attack, you can expend one superiority die to attempt to disarm the target, forcing it to drop one item of your choice that it\\u0027s holding. You add the superiority die to the attack\\u0027s damage roll, and the target must make a Strength saving throw. On a failed save, it drops the object you choose. The object lands at its feet\",\"level\":1}],\"id\":\"Custom681d1fd9-a287-4d30-9040-0a60ee6c0aac\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Disarming Attack\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1},{\"feat\":{\"descriptionModels\":[{\"description\":\"When you hit a creature with a weapon attack, you can expend one superiority die to distract the creature, giving your allies an opening. You add the superiority die to the attack\\u0027s damage roll. The next attack roll against the target by an attacker other than you has advantage if the attack is made before the start of your next turn\",\"level\":1}],\"id\":\"Custom443d2a52-9c38-4a61-8d89-ce69a56c395c\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Distracting Strike\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1},{\"feat\":{\"descriptionModels\":[{\"description\":\"When you move on your turn, you can expend a superiority die, adding the total to your AC until you stop moving\",\"level\":1}],\"id\":\"Custom32bb5049-28c8-42cb-ab51-25c8742e33e0\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Evasive Footwork\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1},{\"feat\":{\"descriptionModels\":[{\"description\":\"You can expend one superiority die and use a bonus action on your turn to feint, choosing one creature within 5 feet of you as your target. Until the end of the turn, you have advantage on your next attack roll against that creature. If that attack hits, add the superiority die to the attack\\u0027s damage roll\",\"level\":1}],\"id\":\"Custome048be4b-61a8-488e-9cdc-61787622c251\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Feinting Attack\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1},{\"feat\":{\"descriptionModels\":[{\"description\":\"When you hit a creature with a weapon attack, you can expend one superiority die to attempt to goad the target into attacking you. You add the superiority die to the attack\\u0027s damage roll, and the target must make a Wisdom saving throw. On a failed save, the target has a disadvantage on all attack rolls against targets other than you until the end of your next turn\",\"level\":1}],\"id\":\"Customd46e484a-4a10-4187-9bed-603e42b9c0c4\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Goading Attack\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1},{\"feat\":{\"descriptionModels\":[{\"description\":\"When you make a melee weapon attack on your turn, you can expend one superiority die to increase your reach for that attack by 5 feet. If you hit, you add the superiority die to the attack\\u0027s damage roll\",\"level\":1}],\"id\":\"Customf8586f3c-94a2-4e5b-bd5e-483f3a0acca3\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Lunging Attack\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1},{\"feat\":{\"descriptionModels\":[{\"description\":\"When you hit a creature with a weapon attack, you can expend one superiority die to maneuver one of your comrades into a more advantageous position. You add the superiority die to the attack\\u0027s damage roll, and you choose a friendly creature who can see or hear you. That creature can use its reaction to move up to half its speed without provoking opportunity attacks from the target of your attack\",\"level\":1}],\"id\":\"Custom5e1e3323-409e-49dc-bc9f-b0358e131a61\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Maneuvering Attack\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1},{\"feat\":{\"descriptionModels\":[{\"description\":\"When you hit a creature with a weapon attack, you can expend one superiority die to attempt to frighten the target. You add the superiority die to the attack\\u0027s damage roll, and the target must make a Wisdom saving throw. On a failed save, it is frightened of you until the end of your next turn\",\"level\":1}],\"id\":\"Custom2c7b48c1-5733-4a9e-b9d4-b17189f22a92\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Menacing Attack\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1},{\"feat\":{\"descriptionModels\":[{\"description\":\"When another creature damages you with a melee attack, you can use your reaction and expend one superiority die to reduce the damage by the number you roll on your superiority die + your Dexterity modifier\",\"level\":1}],\"id\":\"Custom7a41fa64-772b-40b9-9044-05be97b809ee\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Parry\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1},{\"feat\":{\"descriptionModels\":[{\"description\":\"When you make a weapon attack roll against a creature, you can expend one superiority die to add it to the roll. You can use this maneuver before or after making the attack roll, but before any effects of the attack are applied\",\"level\":1}],\"id\":\"Customebebd2e7-e953-44fc-9004-c7cac61fd87c\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Precision Attack\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1},{\"feat\":{\"descriptionModels\":[{\"description\":\"When you hit a creature with a weapon attack, you can expend one superiority die to attempt to drive the target back. You add the superiority die to the attack\\u0027s damage roll, and if the target is Large or smaller, it must make a Strength saving throw. On a failed save, you push the target up to 15 feet away from you\",\"level\":1}],\"id\":\"Custom17890851-50c2-4866-b5d3-5e202e94dc3d\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Pushing Attack\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1},{\"feat\":{\"descriptionModels\":[{\"description\":\"On your turn, you can use a bonus action and expend one superiority die to bolster the resolve of one of your companions. When you do so, choose a friendly creature who can see or hear you. That creature gains temporary hit points equal to the superiority die roll + your Charisma modifier\",\"level\":1}],\"id\":\"Customb85532e6-f3c5-4c23-a231-aedfd8a430a4\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Rally\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1},{\"feat\":{\"descriptionModels\":[{\"description\":\"When a creature misses you with a melee attack, you can use your reaction and expend one superiority die to make a melee attack against the creature. If you hit, you add the superiority die to the attack\\u0027s damage roll\",\"level\":1}],\"id\":\"Custom1cae0388-3992-4b61-853a-689d5dd3acff\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Riposte\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1},{\"feat\":{\"descriptionModels\":[{\"description\":\"When you hit a creature with a melee weapon attack, you can expend one superiority die to attempt to damage another creature with the same attack. Choose another creature within 5 feet of the original target and within your reach. If the original attack roll would hit the second creature, it takes damage equal to the number you roll on your superiority die. The damage is of the same type dealt by the original attack\",\"level\":1}],\"id\":\"Custom295dae76-e091-4b2b-a52d-b370486869cf\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Sweeping Attack\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1},{\"feat\":{\"descriptionModels\":[{\"description\":\"When you hit a creature with a weapon attack, you can expend one superiority die to attempt to knock the target down. You add the superiority die to the attack\\u0027s damage roll, and if the target is Large or smaller, it must make a Strength saving throw or be knocked prone\",\"level\":1}],\"id\":\"Custome7ec4e13-96ec-4cec-b0e7-b9c6c53092ed\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Trip Attack\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1},{\"feat\":{\"descriptionModels\":[{\"description\":\"When you\\u0027re within 5 feet of an ally on your turn, you can expend one superiority die and switch places with that ally, provided you spend at least 5 feet of movement. This movement doesn\\u0027t provoke opportunity attacks. Roll the superiority die. Until the start of your next turn, the ally gains a bonus to AC equal to the number rolled\",\"level\":1}],\"id\":\"Custom8d7ca98e-7478-41a9-8f6d-e4f5d53d0612\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Bait and Switch\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1},{\"feat\":{\"descriptionModels\":[{\"description\":\"When an enemy you can see moves within 5 feet of you, you can use your reaction to expend one superiority die and make one weapon attack against that creature. If the attack hits, add the superiority die to the attack\\u0027s damage roll\",\"level\":1}],\"id\":\"Custom4ed5313f-ea6b-4d98-8eef-8cad8e678407\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Brace\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1},{\"feat\":{\"descriptionModels\":[{\"description\":\"As a bonus action, you can expend one\\nsuperiority die and make a ranged weapon\\nattack You can draw a thrown weapon as part of making this attack. If you hit, add the superiority die to the attack\\u0027s damage roll\",\"level\":1}],\"id\":\"Custom02767aa5-04a7-4837-a273-7f49adc937a0\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Snipe\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1},{\"feat\":{\"descriptionModels\":[{\"description\":\"Immediately after you hit a creature with a\\nmelee weapon attack on your turn, you can\\nexpend one superiority die and use a bonus\\naction to grapple the target (see chapter 9 in the Player\\u0027s Handbook for rules on grappling) Add the superiority die to your Strength (Athletics) check. The target is also restrained while grappled in this way\",\"level\":1}],\"id\":\"Custom6a79c9a2-15f9-44d1-be5b-2cb349d07cab\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Restraining Strike\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1},{\"feat\":{\"descriptionModels\":[{\"description\":\"When you make a Charisma (Deception) check or a Charisma (Persuasion) check, you can expend one superiority die, and add the superiority die to the ability check\",\"level\":1}],\"id\":\"Customac4e4b1e-fe5b-4b86-87fa-f9fc26fc5609\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Silver Toungue\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1},{\"feat\":{\"descriptionModels\":[{\"description\":\"When you make a Wisdom (Insight) check or an Intelligence (Investigation) check, you can expend one superiority die, and add the superiority die to the ability check\",\"level\":1}],\"id\":\"Custom929baf45-f19c-4b7b-8568-37dfa58c02c7\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Studious Eye\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1},{\"feat\":{\"descriptionModels\":[{\"description\":\"When you make a Dexterity (Stealth) check or an initiative roll, you can expend one superiority die and add the die to the roll\",\"level\":1}],\"id\":\"Custome11bb941-e6bf-407f-9452-b6e7a04533ae\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Ambush\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1}],\"canReselect\":true,\"id\":\"22243a86-d43f-49d4-840d-97d629e3394b\",\"name\":\"Manuevers do Estilo de Luta\",\"selectedFeatures\":[]}],\"shouldShowCompanion\":false,\"skillProficiencies\":[],\"specialAbilities\":[{\"abilityCalculators\":[],\"amountsPerLevel\":[{\"amount\":1,\"associatedValue\":\"\",\"level\":-1}],\"associatedValueName\":\"d6\",\"id\":\"04402822-df8c-4612-b413-e918f7f5b657\",\"name\":\"Dados de Superioridade do Estilo de Luta\",\"type\":\"BASIC\",\"usesLeft\":0}],\"spellSlots\":[],\"spellcastingAbility\":\"Intelligence\",\"spells\":[],\"subtypes\":[],\"toolProficiencies\":[],\"weaponProficiencies\":[]},{\"acModifier\":\"Dexterity\",\"armorProficiencies\":[],\"attacksByLevel\":[],\"baseAc\":10,\"classWeapon\":{\"abilityName\":\"Strength\",\"damageType\":\"Bludgeoning\",\"diceAmount\":1,\"diceTypeName\":\"D4\",\"name\":\"\"},\"effectiveCasterLevel\":\"PARENT\",\"features\":[{\"feat\":{\"descriptionModels\":[{\"description\":\"Being unable to see a creature doesn\\u0027t impose disadvantage on your attack rolls against it, provided the creature isn\\u0027t hidden from you\",\"level\":1}],\"id\":\"Custom72f83fca-7b62-49e5-a7c5-533e35e602a9\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Fighting Style: Blind Fighting\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1}],\"hpModifier\":\"Constitution\",\"id\":\"Custom5fba532f-7345-430a-a6c6-53e0fc79022b\",\"jsonType\":\"class\",\"languages\":[],\"modelType\":\"Subtype\",\"multiclassArmor\":true,\"multiclassSkills\":true,\"multiclassTools\":true,\"multiclassWeapons\":true,\"name\":\"Blind Fighting\",\"selectableFeatures\":[],\"shouldShowCompanion\":false,\"skillProficiencies\":[],\"specialAbilities\":[],\"spellSlots\":[],\"spellcastingAbility\":\"Intelligence\",\"spells\":[],\"subtypes\":[],\"toolProficiencies\":[],\"weaponProficiencies\":[]},{\"acModifier\":\"Dexterity\",\"armorProficiencies\":[],\"attacksByLevel\":[],\"baseAc\":10,\"classWeapon\":{\"abilityName\":\"Strength\",\"damageType\":\"Bludgeoning\",\"diceAmount\":1,\"diceTypeName\":\"D4\",\"name\":\"\"},\"effectiveCasterLevel\":\"PARENT\",\"features\":[{\"feat\":{\"descriptionModels\":[{\"description\":\"Interception\\nWhen a creature you can see hits a target that is within 5 feet of you with an attack, you can use your reaction to reduce the damage the target takes by 1d10 + your proficiency bonus (to a minimum of 0 damage). You must be wielding a shield or a simple or martial weapon to use this reaction\",\"level\":1}],\"id\":\"Custom4f65736f-5a7d-4fcd-a7cb-55ea2f96aa38\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Fighting Style: Interception\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1}],\"hpModifier\":\"Constitution\",\"id\":\"Custom97b61ca7-4ca5-4b7a-aed3-4a171c803a83\",\"jsonType\":\"class\",\"languages\":[],\"modelType\":\"Subtype\",\"multiclassArmor\":true,\"multiclassSkills\":true,\"multiclassTools\":true,\"multiclassWeapons\":true,\"name\":\"Interception\",\"selectableFeatures\":[],\"shouldShowCompanion\":false,\"skillProficiencies\":[],\"specialAbilities\":[],\"spellSlots\":[],\"spellcastingAbility\":\"Intelligence\",\"spells\":[],\"subtypes\":[],\"toolProficiencies\":[],\"weaponProficiencies\":[]},{\"acModifier\":\"Dexterity\",\"armorProficiencies\":[],\"attacksByLevel\":[],\"baseAc\":10,\"classWeapon\":{\"abilityName\":\"Strength\",\"damageType\":\"Bludgeoning\",\"diceAmount\":1,\"diceTypeName\":\"D4\",\"name\":\"\"},\"effectiveCasterLevel\":\"PARENT\",\"features\":[{\"feat\":{\"descriptionModels\":[{\"description\":\"Thrown Weapon Fighting\\nYou can draw a weapon that has the throne\\nproperty as part of the attack you make with the weapon. In addition, when you hit with a ranged attack using a thrown weapon, you gain a +1 bonus to the damage roll\",\"level\":1}],\"id\":\"Customc32d2067-e5eb-42de-a116-9f4cd67d6fab\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Fighting Style: Thrown Weapon Fighting\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1}],\"hpModifier\":\"Constitution\",\"id\":\"Custom627726a2-01d6-477c-83d7-99796473fa7a\",\"jsonType\":\"class\",\"languages\":[],\"modelType\":\"Subtype\",\"multiclassArmor\":true,\"multiclassSkills\":true,\"multiclassTools\":true,\"multiclassWeapons\":true,\"name\":\"Thrown Weapon Fighting\",\"selectableFeatures\":[],\"shouldShowCompanion\":false,\"skillProficiencies\":[],\"specialAbilities\":[],\"spellSlots\":[],\"spellcastingAbility\":\"Intelligence\",\"spells\":[],\"subtypes\":[],\"toolProficiencies\":[],\"weaponProficiencies\":[]},{\"acModifier\":\"Dexterity\",\"armorProficiencies\":[],\"attacksByLevel\":[],\"baseAc\":10,\"classWeapon\":{\"abilityName\":\"Strength\",\"damageType\":\"Bludgeoning\",\"diceAmount\":1,\"diceTypeName\":\"D4\",\"name\":\"\"},\"effectiveCasterLevel\":\"PARENT\",\"features\":[{\"feat\":{\"descriptionModels\":[{\"description\":\"Your unarmed strikes can deal bludgeoning\\ndamage equal to 1d6 + your Strength modifier. If you strike with twa free hands, the d6 becomes a d8.\\nWhen you successfully start a grapple, you can deal 1d4 bludgeoning damage to the grappled creature. Until the grapple ends, you can also deal this damage to the creature whenever you hit it with a melee attack\",\"level\":1}],\"id\":\"Customafd6b943-f457-4d08-9d8b-1e7a92675641\",\"isFeature\":true,\"jsonType\":\"feat\",\"level\":1,\"name\":\"Fighting Style: Unarmed Fighting\",\"notes\":\"\",\"type\":\"Feat\"},\"level\":1}],\"hpModifier\":\"Constitution\",\"id\":\"Custom56153ca4-bfc7-4554-8f56-315b5d26800c\",\"jsonType\":\"class\",\"languages\":[],\"modelType\":\"Subtype\",\"multiclassArmor\":true,\"multiclassSkills\":true,\"multiclassTools\":true,\"multiclassWeapons\":true,\"name\":\"Unarmed Fighting\",\"selectableFeatures\":[],\"shouldShowCompanion\":false,\"skillProficiencies\":[],\"specialAbilities\":[],\"spellSlots\":[],\"spellcastingAbility\":\"Intelligence\",\"spells\":[],\"subtypes\":[],\"toolProficiencies\":[],\"weaponProficiencies\":[]}],\"toolProficiencies\":[],\"weaponProficiencies\":[{\"hint\":\"\",\"level\":1,\"proficiency\":\"all_simple\"},{\"hint\":\"\",\"level\":1,\"proficiency\":\"all_martial\"}]}"]},"armors":[{"armor":18,"category":"Heavy Armor","cost":"1500 gp","description":"","equipped":true,"id":"6b973525-6608-4fb0-8b45-586561532e91","isAttuned":false,"isCustom":false,"isProficient":true,"jsonType":"armor","modifierFormatted":"","name":"Plate","pinned":false,"stealthDisadvantage":true,"strRequired":15,"typeName":"Plate","weight":"65 lb."}],"background":{"backgroundId":"knight","languageProficiencies":[{"name":"Dracônico","typeName":"LANGUAGE"}],"skillProficiencies":[{"name":"INSIGHT","typeName":"SKILL"},{"name":"INTIMIDATION","typeName":"SKILL"},{"name":"HISTORY","typeName":"SKILL"},{"name":"PERSUASION","typeName":"SKILL"}],"toolProficiencies":[{"name":"Dados","typeName":"TOOL"}]},"baseAc":10,"baseHp":99,"bonds":"","bonusSpellSlots":{"eighth":0,"fifth":0,"first":0,"fourth":0,"ninth":0,"second":0,"seventh":0,"sixth":0,"third":0},"burrowSpeedModifier":0,"charisma":{"save":false,"saveModifier":0,"score":7,"scoreModifier":0},"climbSpeedModifier":0,"companion":{"abilityScore":{"cha":7,"con":14,"dex":14,"intelligence":2,"str":20,"wis":12},"ac":14,"currentHp":32,"diceAmount":1,"diceFormatted":"d10","id":"de5b2d88-85e9-43b1-96b1-5f1ad7820c4e","initiativeModifier":2,"maxHp":32,"monsterId":1300,"name":"Zariel","passivePerceptionModifier":1,"proficiency":2,"speed":80},"conditions":{},"constitution":{"save":true,"saveModifier":0,"score":14,"scoreModifier":0},"copper":0,"created":"2022-09-14T15:30:44Z","dexterity":{"save":false,"saveModifier":0,"score":10,"scoreModifier":0},"disadvantages":[],"effectApplications":[],"electrum":0,"equipment":[{"amount":1,"description":"","id":"2205e83d-f3c9-476b-aaca-ac7bcc2f84a7","index":0,"isAttuned":false,"isEquipped":false,"name":"Leather Armor, Longbow and 20 Arrows","pinned":false},{"amount":2,"description":"","id":"efd6f8c2-d4ad-49af-b53d-62907216fc42","index":1,"isAttuned":false,"isEquipped":false,"name":"Martial Weapon","pinned":false},{"amount":1,"description":"","id":"264e8f36-f94b-442b-acd1-2362b602717e","index":2,"isAttuned":false,"isEquipped":false,"name":"Explorer\u0027s Pack","pinned":false},{"amount":1,"description":"","id":"f1479e15-68b2-43da-babb-a9bb982a244a","index":3,"isAttuned":false,"isEquipped":false,"name":"Set Of Fine Clothes","pinned":false},{"amount":1,"description":"","id":"f6a125be-cd0e-44a9-866f-7a7cbc936e87","index":4,"isAttuned":false,"isEquipped":false,"name":"Signet Ring","pinned":false},{"amount":1,"description":"","id":"334b28f9-40c1-4936-a7e4-ba9d7c2efc09","index":5,"isAttuned":false,"isEquipped":false,"name":"Scroll Of Pedigree","pinned":false},{"amount":1,"description":"","id":"19dcedd8-c476-4a77-bc7a-7c5d24804061","index":6,"isAttuned":false,"isEquipped":false,"name":"Purse","pinned":false}],"equippedColorSchemeId":"default","equippedDiceId":"plain_blue","exp":195000,"extraAC":0,"failures":0,"feats":[{"descriptions":[{"description":"You have practiced techniques useful in melee combat against spell casters, gaining the following benefits:\n\n- When a creature within 5 feet of you casts a spell, you can use your reaction to make a melee weapon attack against that creature.\n- When you damage a creature that is concentrating on a spell, that creature has disadvantage on the saving throw it makes to maintain its concentration.\n- You have advantage on saving throws against spells cast by creatures within 5 feet of you","level":1}],"id":"mage_slayer","isFeature":false,"jsonType":"feat","name":"Mage Slayer","notes":"","type":"Feat"},{"descriptions":[{"description":"You have mastered techniques to take advantage of every drop in any enemy\u0027s guard, gaining the following benefits:\n\n- When you hit a creature with an opportunity attack, the creature\u0027s speed becomes 0 for the rest of the turn.\n- Creatures provoke opportunity attacks from you even if they take the Disengage action before leaving your reach.\n- When a creature within 5 feet of you makes an attack against a target other than you (and that target doesn\u0027t have this feat), you can use your reaction to make a melee weapon attack against the attacking creature","level":1}],"id":"sentinel","isFeature":false,"jsonType":"feat","name":"Sentinel","notes":"","type":"Feat"},{"descriptions":[{"description":"You are a dangerous foe to face while mounted. While you are mounted and aren\u0027t incapacitated, you gain the following benefits:\n\n- You have advantage on melee attack rolls against any unmounted creature that is smaller than your mount.\n- You can force an attack targeted at your mount to target you instead.\n- If your mount is subjected to an effect that allows it to make a Dexterity saving throw to take only half damage, it instead takes no damage if it succeeds on the saving throw, and only half damage if it fails","level":1}],"id":"mounted_combatant","isFeature":false,"jsonType":"feat","name":"Mounted Combatant","notes":"","type":"Feat"},{"descriptions":[{"description":"You master the shortsword, longsword, scimitar, rapier, and greatsword. You gain the following benefits when using any of them:\n\n- You gain a +1 bonus to attack rolls you make with the weapon.\n- On your turn, you can use your reaction to assume a parrying stance, provided you have the weapon in hand. Doing so grants a +1 bonus to your AC until the start of your next turn or until you\u0027re not holding the weapon.\n- When you make an opportunity attack with the weapon, you have advantage on the attack roll","level":1}],"id":"blade_mastery","isFeature":false,"jsonType":"feat","name":"Blade Mastery","notes":"","type":"Feat"}],"flaws":"","flySpeedModifier":0,"gold":20,"hasInspiration":false,"hp":131,"id":"8d65cf22-4d0e-4424-9268-b29062bbfb0a","ideals":"","image":"/9j/4AAQSkZJRgABAQAAAQABAAD/4gHYSUNDX1BST0ZJTEUAAQEAAAHIAAAAAAQwAABtbnRyUkdC\nIFhZWiAH4AABAAEAAAAAAABhY3NwAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAQAA9tYAAQAA\nAADTLQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAlk\nZXNjAAAA8AAAACRyWFlaAAABFAAAABRnWFlaAAABKAAAABRiWFlaAAABPAAAABR3dHB0AAABUAAA\nABRyVFJDAAABZAAAAChnVFJDAAABZAAAAChiVFJDAAABZAAAAChjcHJ0AAABjAAAADxtbHVjAAAA\nAAAAAAEAAAAMZW5VUwAAAAgAAAAcAHMAUgBHAEJYWVogAAAAAAAAb6IAADj1AAADkFhZWiAAAAAA\nAABimQAAt4UAABjaWFlaIAAAAAAAACSgAAAPhAAAts9YWVogAAAAAAAA9tYAAQAAAADTLXBhcmEA\nAAAAAAQAAAACZmYAAPKnAAANWQAAE9AAAApbAAAAAAAAAABtbHVjAAAAAAAAAAEAAAAMZW5VUwAA\nACAAAAAcAEcAbwBvAGcAbABlACAASQBuAGMALgAgADIAMAAxADb/2wBDAAEBAQEBAQEBAQEBAQEB\nAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQH/2wBDAQEB\nAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEB\nAQEBAQH/wAARCAOmA6gDASIAAhEBAxEB/8QAHgAAAAYDAQEAAAAAAAAAAAAAAwQFBgcIAAIJAQr/\nxABnEAABAwIFAgMFBAcEBQYI